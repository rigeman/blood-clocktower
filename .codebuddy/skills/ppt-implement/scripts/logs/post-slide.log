 var(--theme-gold);\n  --color-theme-blue: var(--theme-blue);\n  --color-theme-purple: var(--theme-purple);\n  --color-theme-crimson: var(--theme-crimson);\n\n  /* === 阵营颜色 === */\n  --color-faction-good: var(--faction-good);\n  --color-faction-evil: var(--faction-evil);\n  --color-faction-neutral: var(--faction-neutral);\n\n  /* === 图表颜色 === */\n  --color-chart-1: var(--chart-1);\n  --color-chart-2: var(--chart-2);\n  --color-chart-3: var(--chart-3);\n  --color-chart-4: var(--chart-4);\n  --color-chart-5: var(--chart-5);\n\n  /* === 侧边栏颜色 === */\n  --color-sidebar: var(--sidebar);\n  --color-sidebar-foreground: var(--sidebar-foreground);\n  --color-sidebar-primary: var(--sidebar-primary);\n  --color-sidebar-primary-foreground: var(--sidebar-primary-foreground);\n  --color-sidebar-accent: var(--sidebar-accent);\n  --color-sidebar-accent-foreground: var(--sidebar-accent-foreground);\n  --color-sidebar-border: var(--sidebar-border);\n  --color-sidebar-ring: var(--sidebar-ring);\n\n  /* === Hero 区域颜色 === */\n  --color-hero: var(--hero);\n  --color-hero-foreground: var(--hero-foreground);\n\n  /* === 阴影 === */\n  --shadow-sm: var(--ds-shadow-sm);\n  --shadow-md: var(--ds-shadow-md);\n  --shadow-lg: var(--ds-shadow-lg);\n  --shadow-xl: var(--ds-shadow-xl);\n\n  /* === 字号 === */\n  --text-xs: var(--font-size-small);\n  --text-sm: var(--font-size-label);\n  --text-base: var(--font-size-body);\n}\n\n:root {\n  /* === 圆角基准值 === */\n  --radius: 0.625rem;\n\n  /* === 字体排版 - 哥特风格 === */\n  --font-family: \"Crimson Text\", Georgia, \"Times New Roman\", serif;\n  --font-family-display: \"Cinzel\", Georgia, \"Times New Roman\", serif;\n  --font-size-display: 3.5rem;\n  --font-size-headline: 2rem;\n  --font-size-title: 1.5rem;\n  --font-size-body: 1rem;\n  --font-size-label: 0.875rem;\n  --font-size-small: 0.75rem;\n  --font-weight-bold: 700;\n  --font-weight-semibold: 600;\n  --font-weight-medium: 500;\n  --font-weight-normal: 400;\n  --line-height: 1.5;\n  --letter-spacing-tight: -0.02em;\n  --letter-spacing-normal: 0;\n  --letter-spacing-wide: 0.1em;\n\n  /* === 间距系统 === */\n  --spacing-xs: 0.5rem;\n  --spacing-sm: 0.75rem;\n  --spacing-md: 1rem;\n  --spacing-lg: 1.5rem;\n  --spacing-xl: 2rem;\n  --spacing-2xl: 3rem;\n  --spacing-3xl: 4rem;\n\n  /* === 阴影层级 - 暗色优先 === */\n  --ds-shadow-sm: 0 1px 3px oklch(0 0 0 / 0.3);\n  --ds-shadow-md: 0 4px 12px oklch(0 0 0 / 0.4), 0 2px 4px oklch(0 0 0 / 0.3);\n  --ds-shadow-lg: 0 8px 24px oklch(0 0 0 / 0.5), 0 4px 8px oklch(0 0 0 / 0.4);\n  --ds-shadow-xl: 0 16px 48px oklch(0 0 0 / 0.6), 0 8px 16px oklch(0 0 0 / 0.5);\n  --shadow-sm: var(--ds-shadow-sm);\n  --shadow-md: var(--ds-shadow-md);\n  --shadow-lg: var(--ds-shadow-lg);\n  --shadow-xl: var(--ds-shadow-xl);\n\n  /* === 动效时间 === */\n  --duration-fast: 150ms;\n  --duration-normal: 200ms;\n  --duration-slow: 300ms;\n  --ease-default: cubic-bezier(0.4, 0, 0.2, 1);\n  --ease-in: cubic-bezier(0.4, 0, 1, 1);\n  --ease-out: cubic-bezier(0, 0, 0.2, 1);\n  --ease-in-out: cubic-bezier(0.4, 0, 0.2, 1);\n  --ease-bounce: cubic-bezier(0.34, 1.56, 0.64, 1);\n\n  /* ================================================\n     暗黑哥特配色 - 主色调\n     ================================================ */\n\n  /* === 背景颜色 - 深邃暗夜 === */\n  --background: oklch(0.12 0.01 270);\n  --foreground: oklch(0.92 0.01 60);\n\n  /* === 卡片 - 深灰带微紫 === */\n  --card: oklch(0.18 0.015 280);\n  --card-foreground: oklch(0.92 0.01 60);\n\n  /* === 弹出层 === */\n  --popover: oklch(0.16 0.015 280);\n  --popover-foreground: oklch(0.92 0.01 60);\n\n  /* === 主色调 - 暗红鲜血 === */\n  --primary: oklch(0.55 0.2 25);\n  --primary-foreground: oklch(0.97 0.01 60);\n\n  /* === 次要色 - 暗紫 === */\n  --secondary: oklch(0.22 0.03 280);\n  --secondary-foreground: oklch(0.88 0.01 60);\n\n  /* === 柔和色 === */\n  --muted: oklch(0.22 0.02 270);\n  --muted-foreground: oklch(0.65 0.02 270);\n\n  /* === 强调色 - 暗金 === */\n  --accent: oklch(0.65 0.15 75);\n  --accent-foreground: oklch(0.12 0.01 270);\n\n  /* === 危险/错误色 - 深红 === */\n  --destructive: oklch(0.55 0.25 20);\n\n  /* === 边框和输入框 === */\n  --border: oklch(0.30 0.02 270);\n  --input: oklch(0.25 0.02 270);\n  --ring: oklch(0.55 0.2 25);\n\n  /* === 功能颜色 === */\n  --success: oklch(0.60 0.15 155);\n  --success-foreground: oklch(0.12 0.01 270);\n  --warning: oklch(0.75 0.17 65);\n  --warning-foreground: oklch(0.12 0.01 270);\n  --info: oklch(0.55 0.15 250);\n  --info-foreground: oklch(0.97 0.01 60);\n\n  /* === 主题特色颜色 === */\n  --theme-red: oklch(0.55 0.25 25);\n  --theme-green: oklch(0.55 0.15 155);\n  --theme-gold: oklch(0.75 0.17 75);\n  --theme-blue: oklch(0.55 0.15 250);\n  --theme-purple: oklch(0.50 0.18 300);\n  --theme-crimson: oklch(0.45 0.28 15);\n\n  /* === 阵营颜色 === */\n  --faction-good: oklch(0.65 0.15 250);\n  --faction-evil: oklch(0.55 0.25 25);\n  --faction-neutral: oklch(0.65 0.12 75);\n\n  /* === 图表颜色 === */\n  --chart-1: oklch(0.55 0.25 25);\n  --chart-2: oklch(0.55 0.15 155);\n  --chart-3: oklch(0.75 0.17 75);\n  --chart-4: oklch(0.50 0.18 300);\n  --chart-5: oklch(0.55 0.15 250);\n\n  /* === 侧边栏 === */\n  --sidebar: oklch(0.14 0.015 280);\n  --sidebar-foreground: oklch(0.92 0.01 60);\n  --sidebar-primary: oklch(0.55 0.2 25);\n  --sidebar-primary-foreground: oklch(0.97 0.01 60);\n  --sidebar-accent: oklch(0.22 0.03 280);\n  --sidebar-accent-foreground: oklch(0.92 0.01 60);\n  --sidebar-border: oklch(0.30 0.02 270);\n  --sidebar-ring: oklch(0.55 0.2 25);\n\n  /* === Hero 区域 - 极深背景 === */\n  --hero: oklch(0.08 0.02 270);\n  --hero-foreground: oklch(0.92 0.01 60);\n}\n\n@layer base {\n  * {\n    @apply border-border outline-ring/50;\n  }\n  body {\n    @apply bg-background text-foreground;\n    font-family: var(--font-family);\n  }\n  h1, h2, h3, h4, h5, h6 {\n    font-family: var(--font-family-display);\n    letter-spacing: var(--letter-spacing-wide);\n  }\n}\n\n/* Tailwind v4: container no longer auto-centers. Restore v3 behavior. */\n@utility container {\n  margin-inline: auto;\n  padding-inline: 1rem;\n  @media (width >= 640px) { max-width: 640px; }\n  @media (width >= 768px) { max-width: 768px; }\n  @media (width >= 1024px) { max-width: 1024px; }\n  @media (width >= 1280px) { max-width: 1280px; }\n  @media (width >= 1536px) { max-width: 1536px; }\n}\n\n/* ================================================================\n   Gothic Special Effects\n   ================================================================ */\n\n/* 血红色发光效果 */\n.glow-crimson {\n  text-shadow: 0 0 10px oklch(0.55 0.25 25 / 0.6), 0 0 30px oklch(0.45 0.28 15 / 0.3);\n}\n\n/* 金色发光效果 */\n.glow-gold {\n  text-shadow: 0 0 10px oklch(0.75 0.17 75 / 0.5), 0 0 20px oklch(0.65 0.15 75 / 0.25);\n}\n\n/* 卡片悬浮发光边框 */\n.card-glow {\n  box-shadow: 0 0 0 1px oklch(0.30 0.02 270), inset 0 0 20px oklch(0.12 0.01 270 / 0.5);\n  transition: box-shadow var(--duration-normal) var(--ease-default);\n}\n.card-glow:hover {\n  box-shadow: 0 0 0 1px oklch(0.55 0.2 25 / 0.5), 0 0 20px oklch(0.55 0.25 25 / 0.15), inset 0 0 20px oklch(0.12 0.01 270 / 0.5);\n}\n\n/* 钟楼圆形布局 */\n.clocktower-ring {\n  position: relative;\n}\n\n/* 死亡玩家标记 */\n.player-dead {\n  opacity: 0.5;\n  filter: grayscale(0.8);\n}\n\n/* 幽灵投票标记 */\n.ghost-vote::after {\n  content: \"👻\";\n  position: absolute;\n  top: -4px;\n  right: -4px;\n  font-size: 0.75rem;\n}\n\n/* 夜晚阶段滤镜 */\n.phase-night {\n  filter: brightness(0.7) saturate(0.8);\n}\n\n/* 白天阶段 */\n.phase-day {\n  filter: brightness(1) saturate(1);\n}\n\n/* 角色卡背面 - 神秘纹样 */\n.role-card-back {\n  background: linear-gradient(135deg, oklch(0.18 0.015 280), oklch(0.12 0.01 270));\n  border: 1px solid oklch(0.30 0.02 270);\n}\n\n/* 哥特式分隔线 */\n.gothic-divider {\n  height: 1px;\n  background: linear-gradient(90deg, transparent, oklch(0.55 0.2 25 / 0.5), oklch(0.75 0.17 75 / 0.5), oklch(0.55 0.2 25 / 0.5), transparent);\n}\n\n/* 血迹效果 */\n.blood-drip {\n  background: linear-gradient(180deg, oklch(0.55 0.25 25), oklch(0.45 0.28 15 / 0));\n  clip-path: polygon(0 0, 100% 0, 100% 60%, 50% 100%, 0 60%);\n}\n\n/* ================================================================\n   Page Transition System\n   ================================================================ */\n.page-transition {\n  transition:\n    opacity var(--duration-normal, 200ms) var(--ease-default, ease),\n    transform var(--duration-normal, 200ms) var(--ease-default, ease),\n    filter var(--duration-normal, 200ms) var(--ease-default, ease);\n}\n\n.page-transition.fade-out { opacity: 0; }\n.page-transition.fade-in  { opacity: 1; }\n\n.page-transition[data-transition=\"slide-up\"].fade-out {\n  opacity: 0;\n  transform: translateY(24px);\n}\n.page-transition[data-transition=\"slide-up\"].fade-in {\n  opacity: 1;\n  transform: translateY(0);\n}\n\n.page-transition[data-transition=\"slide-fade\"].fade-out {\n  opacity: 0;\n  transform: translateX(-24px);\n}\n.page-transition[data-transition=\"slide-fade\"].fade-in {\n  opacity: 1;\n  transform: translateX(0);\n}\n\n.page-transition[data-transition=\"blur-fade\"].fade-out {\n  opacity: 0;\n  filter: blur(12px);\n}\n.page-transition[data-transition=\"blur-fade\"].fade-in {\n  opacity: 1;\n  filter: blur(0px);\n}\n\n.page-transition[data-transition=\"scale\"].fade-out {\n  opacity: 0;\n  transform: scale(0.96);\n}\n.page-transition[data-transition=\"scale\"].fade-in {\n  opacity: 1;\n  transform: scale(1);\n}\n\n.page-transition[data-transition=\"bounce\"] {\n  transition:\n    opacity var(--duration-normal, 200ms) var(--ease-default, ease),\n    transform var(--duration-slow, 300ms) var(--ease-bounce, cubic-bezier(0.34, 1.56, 0.64, 1)),\n    filter var(--duration-normal, 200ms) var(--ease-default, ease);\n}\n.page-transition[data-transition=\"bounce\"].fade-out {\n  opacity: 0;\n  transform: scale(0.92);\n}\n.page-transition[data-transition=\"bounce\"].fade-in {\n  opacity: 1;\n  transform: scale(1);\n}\n\n.page-transition[data-transition=\"none\"] {\n  transition: none !important;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .page-transition {\n    transition: none !important;\n  }\n}\n","file_path":"/workspace/frontend/src/index.css"},"tool_response":"Successfully overwrote file: /workspace/frontend/src/index.css","call_id":"call_5af0e42eb66c434d828a3cf7","tool_use_id":"call_5af0e42eb66c434d828a3cf7","agent_type":"cli","permission_mode":"dontAsk","client":"CLI","version":"2.98.1","generation_id":"2d5c647050af473cb56ecada510753ed","model":"glm-5.1"}
